{
  "annotations": { "list": [] },
  "editable": true,
  "schemaVersion": 39,
  "title": "ExploratorX — Payment Fraud",
  "tags": ["exploratorx", "payment", "fraud"],
  "timezone": "browser",
  "time": { "from": "now-15m", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Payment Events Total",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "payment_events_total", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Fraud Alerts",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "fraud_alerts_total", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Blocked Transactions",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "blocked_transactions_total", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Challenge Required",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "challenge_required_total", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Events / second",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [{ "expr": "events_per_second", "refId": "A" }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Kafka Stream Lag",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [{ "expr": "kafka_stream_lag", "refId": "A" }]
    }
  ]
