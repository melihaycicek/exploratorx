{
  "__inputs": [{ "name": "DS_PROMETHEUS", "type": "datasource", "pluginId": "prometheus", "label": "Prometheus" }],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus" }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "schemaVersion": 39,
  "title": "ExploratorX — Payment Fraud Mode",
  "description": "Real-time payment fraud detection: impossible travel, velocity fraud, duplicates, 3DS challenges",
  "tags": ["exploratorx", "payment", "fraud"],
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total Transactions",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#38bdf8", "value": 0 }] },
          "unit": "short"
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [{ "expr": "payment_events_total", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "BLOCKED 🔴",
      "description": "Transactions with risk score ≥81",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#22c55e", "value": 0 }, { "color": "#ef4444", "value": 1 }] },
          "unit": "short"
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [{ "expr": "payment_blocked_total", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "CHALLENGE 🟠",
      "description": "3DS challenge required (score 61-80)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#22c55e", "value": 0 }, { "color": "#f97316", "value": 1 }] },
          "unit": "short"
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [{ "expr": "payment_challenge_total", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Velocity Fraud 🟡",
      "description": "5+ transactions in 5 minutes on same card",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#22c55e", "value": 0 }, { "color": "#eab308", "value": 1 }] },
          "unit": "short"
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [{ "expr": "payment_velocity_fraud_total", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Duplicates Ignored ⬜",
      "description": "Same idempotency_key rejected",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#6b7280", "value": 0 }] },
          "unit": "short"
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [{ "expr": "payment_duplicate_ignored_total", "refId": "A" }]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Geo Mismatch 🟠",
      "description": "POS country ≠ IP country",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#22c55e", "value": 0 }, { "color": "#f97316", "value": 1 }] },
          "unit": "short"
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [{ "expr": "payment_geo_mismatch_total", "refId": "A" }]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Transaction Rate & Fraud Events per Second",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" },
          "unit": "reqps"
        }
      },
      "targets": [
        { "expr": "rate(payment_events_total[1m])", "refId": "A", "legendFormat": "Transactions/s" },
        { "expr": "rate(payment_blocked_total[1m])", "refId": "B", "legendFormat": "Blocked/s" },
        { "expr": "rate(payment_challenge_total[1m])", "refId": "C", "legendFormat": "Challenge/s" },
        { "expr": "rate(payment_velocity_fraud_total[1m])", "refId": "D", "legendFormat": "Velocity/s" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Average Risk Score over Time",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" },
          "unit": "short", "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#22c55e", "value": 0 }, { "color": "#eab308", "value": 31 }, { "color": "#f97316", "value": 61 }, { "color": "#ef4444", "value": 81 }] }
        }
      },
      "targets": [{ "expr": "rate(payment_risk_score_sum[5m]) / rate(payment_risk_score_count[5m])", "refId": "A", "legendFormat": "Avg Risk Score" }]
    },
    {
      "id": 9,
      "type": "piechart",
      "title": "Fraud Decision Distribution",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "options": { "pieType": "donut", "legend": { "displayMode": "list", "placement": "right" } },
      "targets": [
        { "expr": "payment_blocked_total", "refId": "A", "legendFormat": "BLOCKED 🔴" },
        { "expr": "payment_challenge_total", "refId": "B", "legendFormat": "CHALLENGE 🟠" },
        { "expr": "payment_velocity_fraud_total", "refId": "C", "legendFormat": "VELOCITY 🟡" },
        { "expr": "payment_duplicate_ignored_total", "refId": "D", "legendFormat": "DUPLICATE ⬜" },
        { "expr": "payment_geo_mismatch_total", "refId": "E", "legendFormat": "GEO MISMATCH 🟠" }
      ]
    },
    {
      "id": 10,
      "type": "gauge",
      "title": "Block Rate (last 5m)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#22c55e", "value": 0 }, { "color": "#eab308", "value": 5 }, { "color": "#ef4444", "value": 20 }] },
          "unit": "percent", "min": 0, "max": 100
        }
      },
      "targets": [{ "expr": "100 * rate(payment_blocked_total[5m]) / rate(payment_events_total[5m])", "refId": "A" }]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Impossible Card Travel Events",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "#ef4444", "mode": "fixed" },
          "custom": { "lineWidth": 2, "fillOpacity": 15 },
          "unit": "short"
        }
      },
      "targets": [{ "expr": "rate(payment_impossible_travel_total[1m])", "refId": "A", "legendFormat": "Impossible Travel/s" }]
    }
  ]
}
