{
  "__inputs": [{ "name": "DS_PROMETHEUS", "type": "datasource", "pluginId": "prometheus", "label": "Prometheus" }],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus" }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "schemaVersion": 39,
  "title": "ExploratorX — CDR Mode",
  "description": "Real-time CDR signal anomaly detection: impossible travel, split signals, out-of-order events",
  "tags": ["exploratorx", "cdr", "anomaly"],
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total CDR Events",
      "description": "Total CDR signals processed by Kafka Streams",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#38bdf8", "value": 0 }] },
          "unit": "short", "decimals": 0
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "area" },
      "targets": [{ "expr": "cdr_events_total", "refId": "A", "legendFormat": "Total Events" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Impossible Signals 🔴",
      "description": ">900 km/h subscriber movement",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#22c55e", "value": 0 }, { "color": "#eab308", "value": 1 }, { "color": "#ef4444", "value": 5 }] },
          "unit": "short"
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [{ "expr": "cdr_impossible_signals_total", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Split Signals 🟣",
      "description": "Same subscriber in 2 cities within 60s",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#22c55e", "value": 0 }, { "color": "#a855f7", "value": 1 }] },
          "unit": "short"
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [{ "expr": "cdr_split_signals_total", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Suspicious Movements 🟡",
      "description": "300–900 km/h subscriber movement",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#22c55e", "value": 0 }, { "color": "#eab308", "value": 1 }] },
          "unit": "short"
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [{ "expr": "cdr_suspicious_movements_total", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Out-of-Order Events ⬜",
      "description": "Events arriving with timestamp earlier than last known",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#94a3b8", "value": 0 }] },
          "unit": "short"
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [{ "expr": "cdr_out_of_order_events_total", "refId": "A" }]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Kafka Streams Status",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#ef4444", "value": 0 }, { "color": "#22c55e", "value": 1 }] },
          "unit": "short", "mappings": [{ "type": "value", "options": { "0": { "text": "STOPPED" }, "1": { "text": "RUNNING" } } }]
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [{ "expr": "kafka_streams_running", "refId": "A" }]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "CDR Events per Second",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" },
          "unit": "reqps"
        }
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "rate(cdr_events_total[1m])", "refId": "A", "legendFormat": "Events/s" },
        { "expr": "rate(cdr_impossible_signals_total[1m])", "refId": "B", "legendFormat": "Impossible/s" },
        { "expr": "rate(cdr_split_signals_total[1m])", "refId": "C", "legendFormat": "Split/s" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Anomaly Detection Latency (ms)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 5, "showPoints": "never" },
          "unit": "ms"
        }
      },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(cdr_processing_latency_ms_bucket[5m]))", "refId": "A", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, rate(cdr_processing_latency_ms_bucket[5m]))", "refId": "B", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, rate(cdr_processing_latency_ms_bucket[5m]))", "refId": "C", "legendFormat": "p99" }
      ]
    },
    {
      "id": 9,
      "type": "piechart",
      "title": "Anomaly Decision Distribution",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" } },
      "options": { "pieType": "pie", "legend": { "displayMode": "list", "placement": "right" } },
      "targets": [
        { "expr": "cdr_impossible_signals_total", "refId": "A", "legendFormat": "Impossible 🔴" },
        { "expr": "cdr_split_signals_total", "refId": "B", "legendFormat": "Split 🟣" },
        { "expr": "cdr_suspicious_movements_total", "refId": "C", "legendFormat": "Suspicious 🟡" },
        { "expr": "cdr_out_of_order_events_total", "refId": "D", "legendFormat": "Out-of-Order ⬜" }
      ]
    },
    {
      "id": 10,
      "type": "gauge",
      "title": "Anomaly Rate (last 5m)",
      "description": "Percentage of events that triggered an anomaly",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#22c55e", "value": 0 }, { "color": "#eab308", "value": 10 }, { "color": "#ef4444", "value": 30 }] },
          "unit": "percent", "min": 0, "max": 100
        }
      },
      "targets": [{
        "expr": "100 * (rate(cdr_impossible_signals_total[5m]) + rate(cdr_split_signals_total[5m]) + rate(cdr_suspicious_movements_total[5m])) / rate(cdr_events_total[5m])",
        "refId": "A", "legendFormat": "Anomaly %"
      }]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Kafka Consumer Lag",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#22c55e", "value": 0 }, { "color": "#eab308", "value": 100 }, { "color": "#ef4444", "value": 1000 }] },
          "custom": { "lineWidth": 2 }, "unit": "short"
        }
      },
      "targets": [{ "expr": "kafka_stream_consumer_lag", "refId": "A", "legendFormat": "CDR Lag" }]
    }
  ]
}
