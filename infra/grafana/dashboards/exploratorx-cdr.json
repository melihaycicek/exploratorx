{
  "annotations": { "list": [] },
  "editable": true,
  "schemaVersion": 39,
  "title": "ExploratorX — CDR Mode",
  "tags": ["exploratorx", "cdr"],
  "timezone": "browser",
  "time": { "from": "now-15m", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "CDR Events Total",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "cdr_events_total", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Impossible Signals",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "impossible_signals_total", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Suspicious Movements",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "suspicious_movements_total", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Split Signals",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "split_signals_total", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Events / second",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [{ "expr": "events_per_second", "refId": "A" }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Anomaly Detection Latency (ms)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [{ "expr": "anomaly_detection_latency_ms", "refId": "A" }]
    }
  ]
