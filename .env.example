# ──────────────────────────────────────────────────────────────
# ExploratorX — Environment Configuration (example)
# Copy to .env and adjust as needed.  .env is gitignored.
# ──────────────────────────────────────────────────────────────

# ---- PostgreSQL ----
POSTGRES_DB=exploratorx
# Application user
POSTGRES_APP_USER=exploratorx
POSTGRES_APP_PASSWORD=exploratorx
# Debezium CDC replication user
POSTGRES_DEBEZIUM_USER=debezium
POSTGRES_DEBEZIUM_PASSWORD=debezium
# Superuser used by the postgres image for bootstrap/init
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=exploratorx-postgres
POSTGRES_PORT=5432

# ---- Kafka (KRaft mode, no ZooKeeper) ----
KAFKA_BOOTSTRAP_INTERNAL=exploratorx-kafka:9092
KAFKA_BOOTSTRAP_HOST=localhost:29092
KAFKA_CLUSTER_ID=ExploratorXKRaftCluster1

# ---- Kafka Connect / Debezium ----
CONNECT_URL=http://exploratorx-connect:8083
CONNECT_HOST_PORT=8083
CONNECT_GROUP_ID=exploratorx-connect

# ---- Kafka UI ----
KAFKA_UI_PORT=8090

# ---- Engine (Spring Boot) ----
ENGINE_PORT=8080

# ---- Dashboard (Next.js) ----
DASHBOARD_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=http://localhost:8080/ws

# ---- Observability ----
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
